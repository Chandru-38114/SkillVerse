# SkillVerse frontend settings. Copy to frontend/.env for local development.
# On Vercel, set the same names under Settings → Environment Variables and
# redeploy (Vite reads them only at build/start time).

# Backend address (no trailing slash). Local: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Google OAuth client id (Google Cloud Console → Credentials). Its
# "Authorized JavaScript origins" must include http://localhost:5173 and
# your Vercel URL, otherwise Google shows "Error 400".
VITE_GOOGLE_CLIENT_ID=
