# Backend environment variables for local development.
# This file is intentionally NOT committed to git (.gitignore already excludes .env).
# Copy this to .env and fill in values before running the server.

# JWT secret — MUST be changed to a strong random value in production.
# Generate one: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-before-you-launch

# CORS allowed origins — the URL(s) of your frontend.
# In production, set this to your deployed frontend URL.
# Multiple values can be comma-separated:
#   FRONTEND_URL=https://skillverse.app,https://www.skillverse.app
FRONTEND_URL=http://localhost:5173
