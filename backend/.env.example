# Backend environment variables for local development.
# This file is intentionally NOT committed to git (.gitignore already excludes .env).
# Copy this to .env and fill in values before running the server.

# JWT secret
SECRET_KEY=dev-secret-change-me-before-you-launch

# CORS allowed origins
FRONTEND_URL=http://localhost:5173

# Supabase Storage configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
