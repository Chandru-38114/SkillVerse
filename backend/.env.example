# SkillVerse backend settings. Copy to backend/.env for local development.
# On Render, set the same names under Environment. Never commit real values.

# ── Required ───────────────────────────────────────────────────────────────
# Database. Leave unset locally to use SQLite (backend/skillverse.db).
# Production: the Supabase Postgres connection string.
DATABASE_URL=
# Signs login tokens. Production MUST use a long random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-before-you-launch
# Frontend address(es) allowed to call the API (comma-separated).
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma-separated (optional).
ADDITIONAL_ORIGINS=

# ── Google sign-in (same client id as VITE_GOOGLE_CLIENT_ID in the frontend) ─
GOOGLE_CLIENT_ID=

# ── Supabase Storage (chat files, voice notes, avatars) ───────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Skill Arena questions, study plans, session summaries) ────────────
# Without a key, Python / Java / DSA / Web Development fall back to the built-in
# question banks; summaries and study plans use simple templates.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODELS=qwen/qwen3-4b:free
ARENA_PROVIDER_ORDER=gemini,openrouter
# Skill Arena mix and timing (defaults shown)
ARENA_N_MCQ=12
ARENA_N_TRACE=5
ARENA_N_DEBUG=3
ARENA_N_CODING=2
ARENA_MIN_VALID=14
ARENA_DURATION_MINUTES=45

# ── Email codes (forgot password / verify email) ──────────────────────────
# Real email through Brevo (free, ~300 emails a day, no own domain needed):
#   BREVO_API_KEY = Brevo -> SMTP & API -> API Keys
#   EMAIL_FROM    = a sender address you verified in Brevo (e.g. a SkillVerse Gmail)
# Without them, codes are only printed in the server log.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=SkillVerse
# true = also return the code to the browser (local testing / demo only;
# NEVER on a public site — anyone could reset anyone's password).
# Ignored (always off) once BREVO_API_KEY + EMAIL_FROM are set.
# Default when unset: true for local SQLite, false for Postgres/production.
DEV_OTP_MODE=

# ── Video calls (optional TURN server from metered.ca) ────────────────────
METERED_DOMAIN=
METERED_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Code runner (Java and JavaScript) ─────────────────────────────────────
# The separate runner service in runner/ (see runner/README.md). Python and SQL
# run on this server; without these two, Java/JavaScript show "runner not set up".
# RUNNER_TOKEN must be the same long random value on both services:
#   python -c "import secrets; print(secrets.token_hex(32))"
RUNNER_URL=
RUNNER_TOKEN=
